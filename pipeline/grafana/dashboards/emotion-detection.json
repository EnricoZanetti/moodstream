      "pluginVersion": "12.4.1",
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": ""
          },
          "query": "from(bucket: \"emotions\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"emotion\" and r._field == \"emotion\")\n  |> group()\n  |> map(fn: (r) => ({_time: r._time, _value: 1, emotion: r._value}))\n  |> group(columns: [\"emotion\"])\n  |> aggregateWindow(every: 1m, fn: sum, createEmpty: false)\n  |> rename(columns: {\"emotion\": \"_field\"})",
          "refId": "A"
        }
