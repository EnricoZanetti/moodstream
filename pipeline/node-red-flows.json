    {
        "id": "c6fae4704a3f346f",
        "type": "function",
        "z": "df1af71b9c007b40",
        "name": "Generate Payload",
        "func": "// Extract the emotion from the MQTT payload\nvar raw = String(msg.payload).trim();\nvar emotion = raw.includes(\":\") ? raw.split(\":\")[1].trim() : raw;\n\n// Map emotions to emojis\nvar emojiMap = {\n    \"neutral\": \"😐\",\n    \"happy\": \"😊\",\n    \"sad\": \"😢\",\n    \"angry\": \"😡\",\n    \"surprised\": \"😲\",\n    \"fearful\": \"😨\"\n};\n\n// Get the corresponding emoji\nvar emoji = emojiMap[emotion] || \"❓\";\n\n// Create a structured payload for InfluxDB\nmsg.payload = {\n    emotion: emotion,\n    emoji: emoji,\n    source: \"OpenMV\",\n    timestamp: new Date().toISOString()\n};\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
